# --- Never commit game data ---
# Entire local workspace (dumps, extracts, keys, research binaries)
# Keep only local/README.md tracked
/local/**
!/local/README.md

*.cci
*.CIA
*.cia
*.3ds
*.3DS
*.cxi
*.CXI
*.app
*.APP
*.ncch
*.NCCH
# Game code dumps (prefer IPS patches in git, not full code.bin)
**/code.bin
**/.code.bin
**/exefs/code.bin

# Extracted / prepared game trees
**/romfs/**
**/exefs/**
**/ExtractedRomFS/**
**/ExtractedExeFS/**
**/prepared/**
**/dumps/**
**/nand/**
**/sdmc/**
**/sdmc_dir/**
**/user/nand/**
**/user/sdmc/**

# 3DS keys / secrets (never commit)
aes_keys.txt
*.keys
boot9.bin
boot11.bin
seeddb.bin
movable.sed

# --- Android / Gradle (when code lands) ---
*.apk
*.ap_
*.aab
# Vendored Azahar tree is large; track overlay + build scripts instead
/emulator/
/dist/
*.dex
*.class
bin/
gen/
out/
build/
.gradle/
local.properties
*.iml
.idea/
.cxx/
captures/
.externalNativeBuild/

# NDK / CMake
cmake-build-*/

# --- OS / editor ---
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# --- Local AI / agent session files (never publish) ---
/AGENTS.md
/SOUL.md
/MEMORY.md
/CLAUDE-DESIGN-BRIEF.txt
/Agents.md
/Soul.md
/Memory.md
/info.txt
/Info.txt

# --- Local dogfood / debug capture artifacts (never publish) ---
# Root-level build transcripts, adb logcat captures and ad-hoc screenshots
# (build-*.txt, camlog*.txt, freeze-*.txt, probe-*.txt, *-screenshot.png, ...).
# Nothing tracked lives at the repo root as .txt/.png, so these are blanket rules.
/*.txt
/*.png

# Dogfood captures under screenshots/ — only the shots referenced by README stay
/screenshots/*
!/screenshots/dual-161510.png
!/screenshots/dual-161523.png
!/screenshots/top-161303.png
!/screenshots/top-161324.png
!/screenshots/top-20260725-160720.png

# Local research/one-off helper scripts (not part of the published build)
/scripts/fix-dump-strings.py
/scripts/fix-native-mojibake.py
/scripts/fix-string-mojibake.py
/scripts/parse-re-dumps.py
/scripts/shot-dual.ps1
/scripts/shot-top.ps1

# --- Python / misc research envs ---
.venv/
venv/
__pycache__/
*.pyc

# Large local artifacts
*.7z
*.zip
!docs/**/*.zip
*.rar
*.rvz
*.iso
