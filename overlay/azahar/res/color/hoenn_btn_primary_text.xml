<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined primary: the label is the accent, brighter when pressed, muted when disabled. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/hoenn_neutral_600" />
    <item android:state_pressed="true" android:color="@color/hoenn_accent_100" />
    <item android:state_focused="true" android:color="@color/hoenn_accent_100" />
    <item android:color="@color/hoenn_accent" />
</selector>
