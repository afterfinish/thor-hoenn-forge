<?xml version="1.0" encoding="utf-8"?>
<!--
  Nav chip label: keep readable in every interactive state.
  Default theme focus styling can otherwise blank the label on some devices.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/hoenn_text" />
    <item android:state_pressed="true" android:color="@color/hoenn_text" />
    <item android:state_selected="true" android:color="@color/hoenn_text" />
    <item android:state_activated="true" android:color="@color/hoenn_text" />
    <item android:state_enabled="false" android:color="@color/hoenn_muted" />
    <item android:color="@color/hoenn_text" />
</selector>
