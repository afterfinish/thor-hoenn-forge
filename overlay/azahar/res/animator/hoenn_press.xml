<?xml version="1.0" encoding="utf-8"?>
<!-- Press feedback: subtle 0.98 scale on press (brief §8 "primary button: press scale 0.98"). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.98"
                android:valueType="floatType" android:duration="120"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.98"
                android:valueType="floatType" android:duration="120"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0"
                android:valueType="floatType" android:duration="140"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0"
                android:valueType="floatType" android:duration="140"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </set>
    </item>
</selector>
