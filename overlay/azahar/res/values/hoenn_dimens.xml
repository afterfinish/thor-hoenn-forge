<?xml version="1.0" encoding="utf-8"?>
<!--
  Hoenn Forge — spacing, radius, touch and motion tokens.

  DEFAULT (this file) = ordinary phones in landscape. The tightest target we ship
  is a 3168x1440 phone at ~640 dpi: 792x360 dp window, minus 40 dp top and 32 dp
  bottom of system bars = 720x288 dp of content. Everything below is sized so a
  five-band screen (header / title / body / action / footer) still fits 288 dp
  without scrolling.

  Roomy handhelds (AYN Thor 1920x1080 @400 dpi = 768x432 dp) and tablets get the
  original 56 dp / 32 dp values from values-h400dp and values-sw600dp. Height,
  not width, is the discriminator: every phone target is <= 384 dp tall in
  landscape, the Thor is 432 dp.

  Radii come from the design-tokens board: chips 6 · inputs 8 · buttons 10 · dialogs 14.
  Touch: 44 min · 44 rows · 44 heroes (phone) / 56 heroes (roomy).
-->
<resources>
    <!-- Outer safe margin. Kept small: the window insets are added on top by
         HoennInsets, so this is breathing room inside the cutout/bars, not the
         whole safe area. -->
    <dimen name="hoenn_margin_outer">12dp</dimen>

    <!-- Band rhythm. gap_block separates the header/body/footer bands,
         gap_row stacks controls inside a band, gap_col separates columns. -->
    <dimen name="hoenn_gap_block">10dp</dimen>
    <dimen name="hoenn_gap_row">6dp</dimen>
    <dimen name="hoenn_gap_col">14dp</dimen>

    <!-- Spacing scale: 4 · 8 · 12 · 16 · 24 · 32 · 56 -->
    <dimen name="hoenn_space_4">4dp</dimen>
    <dimen name="hoenn_space_8">8dp</dimen>
    <dimen name="hoenn_space_12">12dp</dimen>
    <dimen name="hoenn_space_16">16dp</dimen>
    <dimen name="hoenn_space_24">24dp</dimen>
    <dimen name="hoenn_space_32">32dp</dimen>
    <dimen name="hoenn_space_56">56dp</dimen>

    <!-- Radii (design-tokens board) -->
    <dimen name="hoenn_radius_chip">6dp</dimen>
    <dimen name="hoenn_radius_input">8dp</dimen>
    <dimen name="hoenn_radius_btn">10dp</dimen>
    <dimen name="hoenn_radius_dialog">14dp</dimen>
    <dimen name="hoenn_radius_card">12dp</dimen>

    <!-- Touch / rhythm -->
    <dimen name="hoenn_touch_min">44dp</dimen>
    <dimen name="hoenn_row_min">44dp</dimen>
    <dimen name="hoenn_btn_height">44dp</dimen>

    <!-- Strokes -->
    <dimen name="hoenn_hairline">1dp</dimen>
    <dimen name="hoenn_stroke">2dp</dimen>        <!-- accent outline / focus ring -->

    <!-- Controller focus ring: 2px accent, offset 2–3px -->
    <dimen name="hoenn_focus_ring">2dp</dimen>
    <dimen name="hoenn_focus_offset">3dp</dimen>

    <!-- Fading-rule end fade (Nocturne signature) -->
    <dimen name="hoenn_rule_fade">48dp</dimen>

    <!-- Padding presets -->
    <dimen name="hoenn_card_pad">12dp</dimen>
    <dimen name="hoenn_btn_pad_h">16dp</dimen>
</resources>
