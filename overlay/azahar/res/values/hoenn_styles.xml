<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Hoenn.Text.Brand" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/hoenn_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Hoenn.Text.Display" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/hoenn_text</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Hoenn.Text.Title" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/hoenn_text</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Hoenn.Text.CardTitle" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/hoenn_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Hoenn.Text.Body" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/hoenn_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>
    <style name="Hoenn.Text.Muted" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/hoenn_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Hoenn.Text.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/hoenn_muted</item>
        <item name="android:textSize">11.5sp</item>
    </style>
    <style name="Hoenn.Text.Mono" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/hoenn_accent_300</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="Hoenn.Text.Accent" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/hoenn_accent_300</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Hoenn.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/hoenn_btn_primary</item>
        <item name="android:textColor">@color/hoenn_accent_300</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">@dimen/hoenn_btn_height</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Hoenn.Button.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/hoenn_btn_secondary</item>
        <item name="android:textColor">@color/hoenn_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">@dimen/hoenn_btn_height</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Hoenn.Button.Ghost" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/hoenn_accent_300</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
