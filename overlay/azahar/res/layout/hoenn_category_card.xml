<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hoenn_bg_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp"
    android:minHeight="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/textCatTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Hoenn.Text.CardTitle"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/chipStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hoenn_chip_muted"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/hoenn_status_vanilla"
            android:textColor="@color/hoenn_text"
            android:textSize="11sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/textCatBlurb"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        style="@style/Hoenn.Text.Muted"
        android:textSize="12sp" />
</LinearLayout>
