<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hoenn_bg_screen"
    android:padding="@dimen/hoenn_margin_outer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <include
            layout="@layout/hoenn_brand_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hoenn_step_3"
            style="@style/Hoenn.Text.Caption" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:orientation="vertical"
            android:paddingEnd="24dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hoenn_dump_title"
                style="@style/Hoenn.Text.Display" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/hoenn_dump_help"
                style="@style/Hoenn.Text.Muted" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hoenn_dump_no_ship"
                style="@style/Hoenn.Text.Body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:background="@drawable/hoenn_bg_card"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/hoenn_dump_find"
                style="@style/Hoenn.Text.Title"
                android:textSize="16sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hoenn_chip_muted"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text=".3ds"
                    android:textColor="@color/hoenn_text"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/hoenn_chip_muted"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text=".cci"
                    android:textColor="@color/hoenn_text"
                    android:textSize="12sp" />
            </LinearLayout>
            <Button
                android:id="@+id/buttonPick"
                style="@style/Hoenn.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hoenn_btn_height"
                android:layout_marginTop="16dp"
                android:minHeight="@dimen/hoenn_btn_height"
                android:text="@string/hoenn_dump_pick" />
            <TextView
                android:id="@+id/buttonWhereDump"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/hoenn_dump_where"
                style="@style/Hoenn.Text.Accent"
                android:focusable="true"
                android:clickable="true" />
            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/hoenn_accent"
                android:visibility="gone" />
            <TextView
                android:id="@+id/textStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                style="@style/Hoenn.Text.Muted" />
            <!-- Same Primary style as Browse; fixed height so focus ring / wrap_content can't squash it -->
            <Button
                android:id="@+id/buttonContinue"
                style="@style/Hoenn.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hoenn_btn_height"
                android:layout_marginTop="16dp"
                android:enabled="false"
                android:minHeight="@dimen/hoenn_btn_height"
                android:text="@string/hoenn_dump_continue"
                android:textColor="@color/hoenn_accent" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:text="@string/hoenn_dump_footer"
        style="@style/Hoenn.Text.Caption" />
</FrameLayout>
