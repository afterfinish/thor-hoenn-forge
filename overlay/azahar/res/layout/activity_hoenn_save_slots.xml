<?xml version="1.0" encoding="utf-8"?>
<!--
  Save / Load state slots — same shell as the START quick menu (transparent root, card).
  Rows are inflated in code into slotList (slots 0..N including quicksave).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slotsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="false">

    <LinearLayout
        android:id="@+id/slotsPanel"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:orientation="vertical"
        android:background="@drawable/hoenn_bg_dialog"
        android:padding="22dp"
        android:clickable="true"
        android:focusable="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="false">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/hoenn_badge"
                android:padding="9dp"
                android:src="@drawable/hoenn_mark"
                android:contentDescription="@string/hoenn_brand"
                android:focusable="false" />
            <TextView
                android:id="@+id/textSlotsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/hoenn_slots_save_title"
                style="@style/Hoenn.Text.Title"
                android:focusable="false" />
            <TextView
                android:id="@+id/chipSlotsGame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/hoenn_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/hoenn_brand"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/hoenn_accent_100"
                android:textSize="13sp"
                android:focusable="false" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:focusable="false">
            <LinearLayout
                android:id="@+id/slotList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:focusable="false" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/hoenn_rule_fade"
            android:focusable="false" />

        <include
            layout="@layout/hoenn_controller_hint_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp" />
    </LinearLayout>
</FrameLayout>
