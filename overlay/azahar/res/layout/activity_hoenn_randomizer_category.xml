<?xml version="1.0" encoding="utf-8"?>
<!--
  Randomizer category panel — header band, title, weighted option list, footer
  actions. Structure was already correct; the gaps now use the shared rhythm
  tokens so it stays compact on a 288 dp-tall phone.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hoenn_bg_screen"
    android:orientation="vertical"
    android:padding="@dimen/hoenn_margin_outer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <include
            layout="@layout/hoenn_brand_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            style="@style/Hoenn.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hoenn_category_fine_tune" />
    </LinearLayout>

    <TextView
        android:id="@+id/textCatTitle"
        style="@style/Hoenn.Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hoenn_gap_row"
        android:ellipsize="end"
        android:maxLines="1" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/hoenn_gap_row"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/optionsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hoenn_bg_card"
            android:orientation="vertical"
            android:padding="@dimen/hoenn_card_pad" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hoenn_gap_row"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonBack"
            style="@style/Hoenn.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hoenn_menu_back" />

        <Button
            android:id="@+id/buttonSave"
            style="@style/Hoenn.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/hoenn_btn_height"
            android:layout_marginStart="8dp"
            android:minWidth="120dp"
            android:text="@string/hoenn_save_category" />
    </LinearLayout>
</LinearLayout>
