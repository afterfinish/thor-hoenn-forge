<?xml version="1.0" encoding="utf-8"?>
<!--
  Ready — two controller tips + Start.

  The tips were a centred wrap_content block (~355 dp) in a 288 dp window, which
  clipped the Start button. The tips row is now the weighted band, Start is a
  fixed 44/56 dp footer control, and the tip body is clipped rather than the
  button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hoenn_bg_screen"
    android:orientation="vertical"
    android:padding="@dimen/hoenn_margin_outer">

    <TextView
        style="@style/Hoenn.Text.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/hoenn_ready_title" />

    <TextView
        style="@style/Hoenn.Text.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/hoenn_ready_subtitle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/hoenn_gap_block"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/hoenn_gap_row"
            android:layout_weight="1"
            android:background="@drawable/hoenn_bg_card"
            android:orientation="vertical"
            android:padding="@dimen/hoenn_card_pad">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/hoenn_chip_muted"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:text="START"
                android:textColor="@color/hoenn_text"
                android:textSize="11sp" />

            <TextView
                style="@style/Hoenn.Text.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hoenn_gap_row"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/hoenn_ready_start_title" />

            <TextView
                style="@style/Hoenn.Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="4"
                android:text="@string/hoenn_ready_start_body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/hoenn_gap_row"
            android:layout_weight="1"
            android:background="@drawable/hoenn_bg_card"
            android:orientation="vertical"
            android:padding="@dimen/hoenn_card_pad">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/hoenn_chip_muted"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:text="L3"
                android:textColor="@color/hoenn_text"
                android:textSize="11sp" />

            <TextView
                style="@style/Hoenn.Text.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hoenn_gap_row"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/hoenn_ready_turbo_title" />

            <TextView
                style="@style/Hoenn.Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="4"
                android:text="@string/hoenn_ready_turbo_body" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/buttonStart"
        style="@style/Hoenn.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hoenn_btn_height"
        android:layout_marginTop="@dimen/hoenn_gap_block"
        android:text="@string/hoenn_ready_start_adventure" />

    <TextView
        style="@style/Hoenn.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/hoenn_ready_footer" />
</LinearLayout>
