<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hoenn_bg_screen"
    android:padding="@dimen/hoenn_margin_outer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/hoenn_ready_title"
            style="@style/Hoenn.Text.Display" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/hoenn_ready_subtitle"
            style="@style/Hoenn.Text.Muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/hoenn_bg_card"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hoenn_chip_muted"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="START"
                    android:textColor="@color/hoenn_text"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/hoenn_ready_start_title"
                    style="@style/Hoenn.Text.CardTitle" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/hoenn_ready_start_body"
                    style="@style/Hoenn.Text.Muted" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/hoenn_bg_card"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hoenn_chip_muted"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="L3"
                    android:textColor="@color/hoenn_text"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/hoenn_ready_turbo_title"
                    style="@style/Hoenn.Text.CardTitle" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/hoenn_ready_turbo_body"
                    style="@style/Hoenn.Text.Muted" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/buttonStart"
            style="@style/Hoenn.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minWidth="240dp"
            android:text="@string/hoenn_ready_start_adventure" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:text="@string/hoenn_ready_footer"
        style="@style/Hoenn.Text.Caption" />
</FrameLayout>
