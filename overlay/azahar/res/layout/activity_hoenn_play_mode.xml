<?xml version="1.0" encoding="utf-8"?>
<!--
  Step 4 — vanilla or randomized.

  The two cards are now the only weighted element (they were 180 dp min-height
  blocks inside a centred wrap_content column, which overflowed by ~100 dp on a
  288 dp-tall phone and pushed both buttons off-screen). Inside each card the
  blurb is the weighted child, so the card's own button is always the last thing
  laid out and therefore always visible.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hoenn_bg_screen"
    android:orientation="vertical"
    android:padding="@dimen/hoenn_margin_outer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <include
            layout="@layout/hoenn_brand_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            style="@style/Hoenn.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hoenn_step_4" />
    </LinearLayout>

    <TextView
        style="@style/Hoenn.Text.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hoenn_gap_row"
        android:gravity="center"
        android:text="@string/hoenn_play_mode_title" />

    <TextView
        android:id="@+id/textGame"
        style="@style/Hoenn.Text.Accent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/textBody"
        style="@style/Hoenn.Text.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/hoenn_play_mode_body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/hoenn_gap_block"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cardVanilla"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/hoenn_gap_col"
            android:layout_weight="1"
            android:background="@drawable/hoenn_bg_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="@dimen/hoenn_card_pad">

            <TextView
                style="@style/Hoenn.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/hoenn_mode_vanilla" />

            <TextView
                style="@style/Hoenn.Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="4"
                android:text="@string/hoenn_mode_vanilla_help" />

            <TextView
                style="@style/Hoenn.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/hoenn_mode_vanilla_footer" />

            <Button
                android:id="@+id/buttonVanilla"
                style="@style/Hoenn.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hoenn_btn_height"
                android:layout_marginTop="@dimen/hoenn_gap_row"
                android:text="@string/hoenn_mode_vanilla" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardRandom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/hoenn_bg_card_selected"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="@dimen/hoenn_card_pad">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Hoenn.Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/hoenn_mode_randomized" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hoenn_chip"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="@string/hoenn_configurable"
                    android:textColor="@color/hoenn_text"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                style="@style/Hoenn.Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="4"
                android:text="@string/hoenn_mode_randomized_help" />

            <TextView
                style="@style/Hoenn.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/hoenn_mode_randomized_footer" />

            <Button
                android:id="@+id/buttonRandomized"
                style="@style/Hoenn.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hoenn_btn_height"
                android:layout_marginTop="@dimen/hoenn_gap_row"
                android:text="@string/hoenn_mode_randomized" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/Hoenn.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hoenn_gap_row"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/hoenn_dump_untouched" />
</LinearLayout>
