<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings shell — nav rail + panel.

  Already the correct band stack; the phone pass only replaces the hard-coded
  20/16/14/12 dp gaps with the shared rhythm tokens, makes the nav rows the touch
  token instead of 48 dp, and gives the panel ScrollView fillViewport so a short
  section body still anchors to the top of the pane.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hoenn_bg_screen"
    android:orientation="vertical"
    android:padding="@dimen/hoenn_margin_outer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="9dp"
            android:contentDescription="@null"
            android:src="@drawable/hoenn_mark" />

        <TextView
            style="@style/Hoenn.Text.Brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hoenn_brand" />

        <TextView
            style="@style/Hoenn.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="/" />

        <TextView
            style="@style/Hoenn.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/hoenn_settings"
            android:textColor="@color/hoenn_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/hoenn_gap_block"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Scroll so Data / About / Advanced always fit in landscape -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.85"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:paddingEnd="@dimen/hoenn_gap_col">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/navDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hoenn_bg_card_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/hoenn_row_min"
                    android:padding="10dp"
                    android:text="Display"
                    android:textColor="@color/hoenn_nav_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/navControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/hoenn_bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/hoenn_row_min"
                    android:padding="10dp"
                    android:text="Controls"
                    android:textColor="@color/hoenn_nav_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/navGraphics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/hoenn_bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/hoenn_row_min"
                    android:padding="10dp"
                    android:text="Graphics performance"
                    android:textColor="@color/hoenn_nav_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/navRandomizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/hoenn_bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/hoenn_row_min"
                    android:padding="10dp"
                    android:text="Randomizer"
                    android:textColor="@color/hoenn_nav_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/navData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/hoenn_bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/hoenn_row_min"
                    android:padding="10dp"
                    android:text="Data"
                    android:textColor="@color/hoenn_nav_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/navAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/hoenn_bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/hoenn_row_min"
                    android:padding="10dp"
                    android:text="About"
                    android:textColor="@color/hoenn_nav_text"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/buttonAdvanced"
                    style="@style/Hoenn.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hoenn_btn_height"
                    android:layout_marginTop="@dimen/hoenn_gap_block"
                    android:gravity="start|center_vertical"
                    android:paddingStart="14dp"
                    android:text="@string/hoenn_advanced" />

                <TextView
                    style="@style/Hoenn.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/hoenn_settings_advanced_hint" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:id="@+id/panelContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="6dp">

                <TextView
                    android:id="@+id/textSectionTitle"
                    style="@style/Hoenn.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hoenn_settings_display" />

                <TextView
                    android:id="@+id/textSectionBody"
                    style="@style/Hoenn.Text.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hoenn_gap_block" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hoenn_gap_row"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Hoenn.Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/hoenn_settings_footer" />

        <Button
            android:id="@+id/buttonBack"
            style="@style/Hoenn.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hoenn_menu_back" />
    </LinearLayout>
</LinearLayout>
