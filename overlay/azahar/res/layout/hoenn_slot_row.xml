<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/hoenn_row_menu"
    android:padding="10dp"
    android:focusable="true"
    android:clickable="true">

    <View
        android:id="@+id/slotThumb"
        android:layout_width="84dp"
        android:layout_height="48dp"
        android:background="@drawable/hoenn_slot_thumb" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical"
        android:focusable="false">
        <TextView
            android:id="@+id/slotTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Hoenn.Text.CardTitle"
            android:focusable="false" />
        <TextView
            android:id="@+id/slotMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Hoenn.Text.Muted"
            android:focusable="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/slotAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Hoenn.Text.Accent"
        android:focusable="false" />
</LinearLayout>
