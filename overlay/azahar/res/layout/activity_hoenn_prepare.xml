<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hoenn_bg_screen"
    android:padding="@dimen/hoenn_margin_outer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="40dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/hoenn_prepare_title"
            style="@style/Hoenn.Text.Display" />
        <TextView
            android:id="@+id/textDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/hoenn_prepare_subtitle"
            style="@style/Hoenn.Text.Muted" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="28dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/hoenn_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">
                <TextView
                    android:id="@+id/stageCopy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hoenn_prepare_stage_copy"
                    style="@style/Hoenn.Text.Body" />
                <TextView
                    android:id="@+id/stageCopyMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Hoenn.Text.Muted" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/hoenn_stroke" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">
                <TextView
                    android:id="@+id/stageExtract"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hoenn_prepare_stage_extract"
                    style="@style/Hoenn.Text.Body" />
                <TextView
                    android:id="@+id/stageExtractMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Hoenn.Text.Muted" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/hoenn_stroke" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">
                <TextView
                    android:id="@+id/stageRandom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hoenn_prepare_stage_randomize"
                    style="@style/Hoenn.Text.Body" />
                <TextView
                    android:id="@+id/stageRandomMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Hoenn.Text.Muted" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/hoenn_stroke" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">
                <TextView
                    android:id="@+id/stageFinalize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hoenn_prepare_stage_finalize"
                    style="@style/Hoenn.Text.Body"
                    android:textColor="@color/hoenn_muted" />
                <TextView
                    android:id="@+id/stageFinalizeMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Hoenn.Text.Muted" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            style="@style/Hoenn.Text.Caption"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/textFree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Hoenn.Text.Caption" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="·"
                style="@style/Hoenn.Text.Caption" />
            <Button
                android:id="@+id/buttonCancel"
                style="@style/Hoenn.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="@string/hoenn_prepare_cancel" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/hoenn_prepare_safe_cancel"
            style="@style/Hoenn.Text.Caption" />
    </LinearLayout>
</FrameLayout>
