<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hoenn_bg_screen"
    android:padding="@dimen/hoenn_margin_outer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hoenn_brand"
            style="@style/Hoenn.Text.Brand" />
        <TextView
            android:id="@+id/textFreeSpace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Hoenn.Text.Caption" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:layout_marginEnd="16dp"
            android:background="@drawable/hoenn_bg_card"
            android:orientation="vertical"
            android:padding="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hoenn_continue_adventure"
                    style="@style/Hoenn.Text.Accent"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/chipMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hoenn_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/hoenn_text"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/textGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/Hoenn.Text.Display"
                android:textSize="26sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/textMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Hoenn.Text.Muted" />
                <TextView
                    android:id="@+id/chipSeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/hoenn_chip_muted"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    style="@style/Hoenn.Text.Mono"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/chipModules"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/hoenn_chip_muted"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/hoenn_text"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="16dp"
                android:background="@drawable/hoenn_bg_screen"
                android:minHeight="80dp">
                <TextView
                    android:id="@+id/textMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/hoenn_home_snapshot"
                    style="@style/Hoenn.Text.Caption"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1" />
            </FrameLayout>
            <Button
                android:id="@+id/buttonPlay"
                style="@style/Hoenn.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hoenn_play" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.85"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/buttonNewRun"
                style="@style/Hoenn.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hoenn_new_run"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="8dp"
                android:text="@string/hoenn_new_run_hint"
                style="@style/Hoenn.Text.Caption" />
            <Button
                android:id="@+id/buttonVanilla"
                style="@style/Hoenn.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/hoenn_play_vanilla"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="8dp"
                android:text="@string/hoenn_play_vanilla_hint"
                style="@style/Hoenn.Text.Caption" />
            <Button
                android:id="@+id/buttonSettings"
                style="@style/Hoenn.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/hoenn_settings"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/hoenn_home_footer"
                style="@style/Hoenn.Text.Caption" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
