<?xml version="1.0" encoding="utf-8"?>
<!--
  Home — "ready to forge".

  Band stack (header / body / no screen footer). The left card is the hero and
  keeps the Play button anchored under a weighted snapshot strip; the right
  column is a set of three secondary actions whose labels are single-line so the
  column's height is predictable (218 dp at the 12.5 sp phone type scale, inside
  a 238 dp body on the smallest supported phone).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hoenn_bg_screen"
    android:orientation="vertical"
    android:padding="@dimen/hoenn_margin_outer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <include
            layout="@layout/hoenn_brand_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/textFreeSpace"
            style="@style/Hoenn.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/hoenn_gap_block"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/hoenn_gap_col"
            android:layout_weight="1.25"
            android:background="@drawable/hoenn_bg_card"
            android:orientation="vertical"
            android:padding="@dimen/hoenn_card_pad">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Hoenn.Text.Accent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.08"
                    android:text="@string/hoenn_continue_adventure"
                    android:textAllCaps="true"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hoenn_chip"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/hoenn_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textGame"
                style="@style/Hoenn.Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hoenn_gap_row"
                android:ellipsize="end"
                android:maxLines="2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textMode"
                    style="@style/Hoenn.Text.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/chipSeed"
                    style="@style/Hoenn.Text.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/hoenn_chip_muted"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/chipModules"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/hoenn_chip_muted"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/hoenn_text"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Only this strip flexes. minHeight 0 so it can never push Play out. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/hoenn_gap_row"
                android:layout_weight="1"
                android:background="@drawable/hoenn_bg_screen">

                <TextView
                    android:id="@+id/textMeta"
                    style="@style/Hoenn.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:maxLines="2"
                    android:text="@string/hoenn_home_snapshot"
                    android:textAllCaps="true" />
            </FrameLayout>

            <Button
                android:id="@+id/buttonPlay"
                style="@style/Hoenn.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hoenn_btn_height"
                android:layout_marginTop="@dimen/hoenn_gap_row"
                android:text="@string/hoenn_play" />
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.85"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/buttonNewRun"
                    style="@style/Hoenn.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hoenn_btn_height"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:text="@string/hoenn_new_run" />

                <TextView
                    style="@style/Hoenn.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:text="@string/hoenn_new_run_hint" />

                <Button
                    android:id="@+id/buttonVanilla"
                    style="@style/Hoenn.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hoenn_btn_height"
                    android:layout_marginTop="@dimen/hoenn_gap_row"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:text="@string/hoenn_play_vanilla" />

                <TextView
                    style="@style/Hoenn.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:text="@string/hoenn_play_vanilla_hint" />

                <Button
                    android:id="@+id/buttonSettings"
                    style="@style/Hoenn.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hoenn_btn_height"
                    android:layout_marginTop="@dimen/hoenn_gap_row"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:text="@string/hoenn_settings" />

                <TextView
                    style="@style/Hoenn.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hoenn_gap_block"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/hoenn_home_footer" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
