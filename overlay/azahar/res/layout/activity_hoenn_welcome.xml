<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hoenn_bg_screen"
    android:padding="@dimen/hoenn_margin_outer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hoenn_brand"
            style="@style/Hoenn.Text.Brand" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hoenn_step_1"
            style="@style/Hoenn.Text.Caption" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:orientation="vertical"
            android:paddingEnd="24dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hoenn_welcome_title"
                style="@style/Hoenn.Text.Display" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hoenn_welcome_body"
                style="@style/Hoenn.Text.Body"
                android:textColor="@color/hoenn_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:orientation="vertical"
            android:paddingStart="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/hoenn_bg_card"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <CheckBox
                    android:id="@+id/checkboxLegal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Hoenn.CheckBox"
                    android:text="@string/hoenn_welcome_checkbox"
                    android:textSize="14sp" />
            </LinearLayout>
            <Button
                android:id="@+id/buttonContinue"
                style="@style/Hoenn.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:enabled="false"
                android:text="@string/hoenn_continue" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/hoenn_whats_dump"
                style="@style/Hoenn.Text.Accent" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:text="@string/hoenn_legal_footer"
        style="@style/Hoenn.Text.Caption" />
</FrameLayout>
