<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hoenn_bg_screen"
    android:orientation="vertical"
    android:padding="@dimen/hoenn_margin_outer">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <include
            layout="@layout/hoenn_brand_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hoenn_step_5"
            style="@style/Hoenn.Text.Caption" />
    </LinearLayout>

    <!-- Title row + seed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hoenn_randomizer_title"
            style="@style/Hoenn.Text.Title"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/chipGame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/hoenn_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/hoenn_text"
            android:textSize="12sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/hoenn_seed_label"
            style="@style/Hoenn.Text.Muted" />
        <TextView
            android:id="@+id/textSeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hoenn_chip_muted"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            style="@style/Hoenn.Text.Mono" />
        <Button
            android:id="@+id/buttonRerollSeed"
            style="@style/Hoenn.Button.Ghost"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:text="@string/hoenn_seed_reroll_short"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Preset cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout
            android:id="@+id/cardPresetLight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/hoenn_bg_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="14dp"
            android:minHeight="72dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hoenn_preset_light"
                style="@style/Hoenn.Text.CardTitle" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/hoenn_preset_light_desc"
                style="@style/Hoenn.Text.Muted" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cardPresetStandard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/hoenn_bg_card_selected"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="14dp"
            android:minHeight="72dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hoenn_preset_standard"
                style="@style/Hoenn.Text.CardTitle" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/hoenn_preset_standard_desc"
                style="@style/Hoenn.Text.Muted" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cardPresetChaos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/hoenn_bg_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="14dp"
            android:minHeight="72dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hoenn_preset_chaos"
                style="@style/Hoenn.Text.CardTitle" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/hoenn_preset_chaos_desc"
                style="@style/Hoenn.Text.Muted" />
        </LinearLayout>
    </LinearLayout>

    <!-- Category grid row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <include layout="@layout/hoenn_category_card"
                android:id="@+id/catWilds"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp" />
            <include layout="@layout/hoenn_category_card"
                android:id="@+id/catTrainers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp" />
            <include layout="@layout/hoenn_category_card"
                android:id="@+id/catStarters"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp" />
            <include layout="@layout/hoenn_category_card"
                android:id="@+id/catPersonal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <include layout="@layout/hoenn_category_card"
                android:id="@+id/catMoves"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp" />
            <include layout="@layout/hoenn_category_card"
                android:id="@+id/catEvolutions"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp" />
            <include layout="@layout/hoenn_category_card"
                android:id="@+id/catMisc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/hoenn_category_hint"
                style="@style/Hoenn.Text.Caption" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hoenn_seed_share_hint"
            style="@style/Hoenn.Text.Caption" />
        <Button
            android:id="@+id/buttonBack"
            style="@style/Hoenn.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hoenn_menu_back" />
        <Button
            android:id="@+id/buttonReview"
            style="@style/Hoenn.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="160dp"
            android:text="@string/hoenn_review_run" />
    </LinearLayout>
</LinearLayout>
