<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hoenn_bg_screen"
    android:orientation="horizontal"
    android:padding="@dimen/hoenn_margin_outer"
    android:baselineAligned="false">

    <!-- Left: summary list -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:layout_marginEnd="20dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hoenn_brand"
                style="@style/Hoenn.Text.Brand" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hoenn_step_5"
                style="@style/Hoenn.Text.Caption" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/hoenn_summary_ready_title"
            style="@style/Hoenn.Text.Display" />
        <LinearLayout
            android:id="@+id/summaryRows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="20dp"
            android:orientation="vertical" />
        <TextView
            android:id="@+id/textWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/hoenn_bg_card"
            android:padding="14dp"
            android:text="@string/hoenn_randomizer_warning"
            android:textColor="@color/hoenn_warning"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Right: this run card -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.85"
        android:background="@drawable/hoenn_bg_card"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hoenn_this_run"
            style="@style/Hoenn.Text.Accent"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/textSeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/hoenn_chip_muted"
            android:padding="12dp"
            style="@style/Hoenn.Text.Mono"
            android:textSize="16sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/chipGame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/hoenn_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/hoenn_text"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/chipModules"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/hoenn_chip_muted"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/hoenn_text"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:text="@string/hoenn_summary_share"
            style="@style/Hoenn.Text.Muted" />
        <Button
            android:id="@+id/buttonForge"
            style="@style/Hoenn.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hoenn_forge_this_run" />
        <Button
            android:id="@+id/buttonBack"
            style="@style/Hoenn.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/hoenn_back_to_edit" />
    </LinearLayout>
</LinearLayout>
