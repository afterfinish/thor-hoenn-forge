<?xml version="1.0" encoding="utf-8"?>
<!--
  Step 6 — review the run.

  The header used to live inside the left column only, which meant the right card
  started at y=0 while the left column started at y=0 too but with a 20 dp gap
  under the brand. The header is now a full-width band like every other screen,
  and both columns sit in the weighted body. The right card's share text is the
  weighted child, so Forge / Back are always laid out last and always visible.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hoenn_bg_screen"
    android:orientation="vertical"
    android:padding="@dimen/hoenn_margin_outer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <include
            layout="@layout/hoenn_brand_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            style="@style/Hoenn.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hoenn_step_5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/hoenn_gap_block"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Left: summary list -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/hoenn_gap_col"
            android:layout_weight="1.15"
            android:orientation="vertical">

            <TextView
                style="@style/Hoenn.Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hoenn_summary_ready_title" />

            <LinearLayout
                android:id="@+id/summaryRows"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/hoenn_gap_row"
                android:layout_weight="1"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/textWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hoenn_gap_row"
                android:background="@drawable/hoenn_bg_card"
                android:ellipsize="end"
                android:maxLines="2"
                android:padding="8dp"
                android:text="@string/hoenn_randomizer_warning"
                android:textColor="@color/hoenn_warning"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Right: this run card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.85"
            android:background="@drawable/hoenn_bg_card"
            android:orientation="vertical"
            android:padding="@dimen/hoenn_card_pad">

            <TextView
                style="@style/Hoenn.Text.Accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/hoenn_this_run"
                android:textAllCaps="true"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/textSeed"
                style="@style/Hoenn.Text.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/hoenn_chip_muted"
                android:ellipsize="end"
                android:maxLines="1"
                android:padding="8dp"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hoenn_gap_row"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipGame"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hoenn_chip"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/hoenn_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipModules"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/hoenn_chip_muted"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/hoenn_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                style="@style/Hoenn.Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/hoenn_gap_row"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="4"
                android:text="@string/hoenn_summary_share" />

            <Button
                android:id="@+id/buttonForge"
                style="@style/Hoenn.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hoenn_btn_height"
                android:text="@string/hoenn_forge_this_run" />

            <Button
                android:id="@+id/buttonBack"
                style="@style/Hoenn.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hoenn_btn_height"
                android:layout_marginTop="@dimen/hoenn_gap_row"
                android:text="@string/hoenn_back_to_edit" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
