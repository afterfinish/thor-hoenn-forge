<?xml version="1.0" encoding="utf-8"?>
<!--
  Nocturne signature rule: a hairline that fades to transparent at both ends
  instead of stopping cleanly. Use as the background of a 1dp-tall View.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@android:color/transparent"
        android:centerColor="@color/hoenn_divider"
        android:endColor="@android:color/transparent" />
    <size android:height="1dp" />
</shape>
