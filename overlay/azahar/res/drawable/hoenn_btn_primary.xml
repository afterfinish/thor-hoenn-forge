<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/hoenn_surface_elevated" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="1dp" android:color="@color/hoenn_stroke" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hoenn_accent_800" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="@dimen/hoenn_stroke" android:color="@color/hoenn_accent_300" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hoenn_surface" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="@dimen/hoenn_stroke" android:color="@color/hoenn_accent" />
        </shape>
    </item>
</selector>
