<?xml version="1.0" encoding="utf-8"?>
<!--
  Primary action — Nocturne outlined button: transparent ground, a 2px accent
  outline, accent label. NEVER an accent flood. Pressed = a faint accent tint.
  Focused (controller) = the signature double ring: an outer accent ring, a gap,
  then the button's own accent outline.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Disabled: dim outline, no fill (label drops to muted via the text color list) -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="@dimen/hoenn_stroke" android:color="@color/hoenn_neutral_700" />
        </shape>
    </item>

    <!-- Focused (D-pad / stick): same box size as default — tint + strong outline (no inset layer-list) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hoenn_accent_tint_12" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="3dp" android:color="@color/hoenn_accent" />
        </shape>
    </item>

    <!-- Pressed: stronger accent tint under the outline -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hoenn_accent_tint_22" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="@dimen/hoenn_stroke" android:color="@color/hoenn_accent" />
        </shape>
    </item>

    <!-- Default: transparent, 2px accent outline -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="@dimen/hoenn_stroke" android:color="@color/hoenn_accent" />
        </shape>
    </item>
</selector>
