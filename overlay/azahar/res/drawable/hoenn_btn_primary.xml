<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled: muted, still readable -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#FF2A2C3C" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
        </shape>
    </item>
    <!-- Focused (controller): bright accent fill -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hoenn_accent" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="3dp" android:color="@color/hoenn_accent_300" />
        </shape>
    </item>
    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hoenn_accent_800" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="2dp" android:color="@color/hoenn_accent_300" />
        </shape>
    </item>
    <!-- Enabled default: solid accent so white text is readable -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hoenn_accent" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
        </shape>
    </item>
</selector>
