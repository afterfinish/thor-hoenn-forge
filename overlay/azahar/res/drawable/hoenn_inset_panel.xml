<?xml version="1.0" encoding="utf-8"?>
<!-- Recessed panel (e.g. the "LAST-SESSION SNAPSHOT" well on Home): a darker inset with a soft top-down gradient. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="@color/hoenn_inset_top"
        android:endColor="@color/hoenn_inset_bottom" />
    <corners android:radius="@dimen/hoenn_radius_input" />
    <stroke android:width="@dimen/hoenn_hairline" android:color="@color/hoenn_divider" />
</shape>
