<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary action — neutral hairline outline on transparent; subtle text-tint on interaction. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="@dimen/hoenn_hairline" android:color="@color/hoenn_neutral_800" />
        </shape>
    </item>

    <!-- Focused: same size as default (no inset double-ring — that squashed buttons on Thor) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hoenn_text_tint_07" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="3dp" android:color="@color/hoenn_accent" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hoenn_text_tint_14" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="@dimen/hoenn_hairline" android:color="@color/hoenn_divider" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="@dimen/hoenn_hairline" android:color="@color/hoenn_divider" />
        </shape>
    </item>
</selector>
