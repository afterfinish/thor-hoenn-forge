<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#FF232532" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="1dp" android:color="#44FFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2A2C3C" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="3dp" android:color="@color/hoenn_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2A2C3C" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="2dp" android:color="@color/hoenn_accent_300" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hoenn_surface" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
</selector>
