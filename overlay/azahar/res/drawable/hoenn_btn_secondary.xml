<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary action — neutral hairline outline on transparent; subtle text-tint on interaction. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="@dimen/hoenn_hairline" android:color="@color/hoenn_neutral_800" />
        </shape>
    </item>

    <!-- Focused: accent double ring (same signature as primary) -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="14dp" />
                    <stroke android:width="@dimen/hoenn_focus_ring" android:color="@color/hoenn_accent" />
                </shape>
            </item>
            <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/hoenn_text_tint_07" />
                    <corners android:radius="@dimen/hoenn_radius_btn" />
                    <stroke android:width="@dimen/hoenn_hairline" android:color="@color/hoenn_divider" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hoenn_text_tint_14" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="@dimen/hoenn_hairline" android:color="@color/hoenn_divider" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="@dimen/hoenn_hairline" android:color="@color/hoenn_divider" />
        </shape>
    </item>
</selector>
