<?xml version="1.0" encoding="utf-8"?>
<!-- Text input / seed field: surface fill, 8dp radius, neutral hairline; accent ring on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hoenn_surface" />
            <corners android:radius="@dimen/hoenn_radius_input" />
            <stroke android:width="@dimen/hoenn_stroke" android:color="@color/hoenn_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hoenn_surface" />
            <corners android:radius="@dimen/hoenn_radius_input" />
            <stroke android:width="@dimen/hoenn_hairline" android:color="@color/hoenn_divider" />
        </shape>
    </item>
</selector>
