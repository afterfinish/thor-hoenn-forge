<?xml version="1.0" encoding="utf-8"?>
<!-- Destructive action — danger outline on transparent; danger label. Same outline logic as primary. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="@dimen/hoenn_stroke" android:color="@color/hoenn_neutral_700" />
        </shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="14dp" />
                    <stroke android:width="@dimen/hoenn_focus_ring" android:color="@color/hoenn_danger" />
                </shape>
            </item>
            <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/hoenn_danger_tint_12" />
                    <corners android:radius="@dimen/hoenn_radius_btn" />
                    <stroke android:width="@dimen/hoenn_stroke" android:color="@color/hoenn_danger" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hoenn_danger_tint_22" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="@dimen/hoenn_stroke" android:color="@color/hoenn_danger" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/hoenn_radius_btn" />
            <stroke android:width="@dimen/hoenn_stroke" android:color="@color/hoenn_danger" />
        </shape>
    </item>
</selector>
