<?xml version="1.0" encoding="utf-8"?>
<!-- Turbo toast entrance (bottom-left, then auto-fades after ~1.2s). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="160" />
    <translate android:fromYDelta="40%p" android:toYDelta="0" android:duration="200" />
</set>
