{
  "name": "AYN Thor defaults",
  "version": 2,
  "notes": "Dual AMOLED: primary=top only, secondary=bottom only. Odin Controller Xbox+HAT. Overlay off.",
  "graphics": {
    "resolution_factor": 3,
    "graphics_api": "vulkan",
    "new_3ds": true,
    "async_shaders": true,
    "disk_shader_cache": true
  },
  "layout": {
    "enable_secondary_display": true,
    "screen_layout": "single_screen",
    "secondary_display_layout": "bottom_screen_only",
    "swap_screen": false,
    "show_input_overlay": false
  },
  "controls": {
    "device": "Odin Controller",
    "auto_map": "xbox_face_buttons_hat_dpad",
    "circle_pad": "left_stick_xy",
    "c_stick": "right_stick_z_rz"
  }
}
