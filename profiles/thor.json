{
  "name": "AYN Thor defaults",
  "version": 3,
  "notes": "Dual AMOLED layout, 3DS face buttons, L3 turbo, async+disk shaders.",
  "graphics": {
    "resolution_factor": 3,
    "graphics_api": "vulkan",
    "new_3ds": true,
    "async_shader_compilation": true,
    "use_disk_shader_cache": true,
    "use_hw_shader": true,
    "use_shader_jit": true
  },
  "layout": {
    "enable_secondary_display": true,
    "screen_layout": "single_screen",
    "secondary_display_layout": "bottom_screen_only",
    "swap_screen": false,
    "show_input_overlay": false
  },
  "controls": {
    "device": "Odin Controller",
    "face_buttons": "nintendo_3ds_layout",
    "dpad": "hat_axis",
    "circle_pad": "left_stick_xy",
    "c_stick": "right_stick_z_rz",
    "l3_hotkey": "turbo_toggle",
    "turbo_limit_percent": 300
  }
}
